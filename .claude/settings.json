{
  "permissions": {
    "allow": [
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "WebFetch",
      "WebSearch",
      "mcp__FGAC_ai__create_temporary_api_key",
      "Bash(mkdir -p local)",
      "Write(/local/.fgac_key)",
      "Bash(python scripts/digest_gmail_check.py:*)",
      "Bash(python3 scripts/digest_gmail_check.py:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*__google_api_modify",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "PY=$(command -v python3 || command -v python); \"$PY\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/followup_queue_guard.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "PY=$(command -v python3 || command -v python); \"$PY\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/html_mail_guard.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "PY=$(command -v python3 || command -v python); \"$PY\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/pitch_queue_cap.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "PY=$(command -v python3 || command -v python); \"$PY\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/pitch_draft_qc.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "PY=$(command -v python3 || command -v python); \"$PY\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/buyer_gate_guard.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "PY=$(command -v python3 || command -v python); \"$PY\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/send_window_guard.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "PY=$(command -v python3 || command -v python); \"$PY\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/no_script_sends.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_memory_rewrite.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*__google_api_(get|modify)",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "PY=$(command -v python3 || command -v python); \"$PY\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/pitch_queue_cap.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "PY=$(command -v python3 || command -v python); \"$PY\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/send_window_guard.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "grep -qi 'bingo' && printf '%s' '{\"hookSpecificOutput\":{\"hookEventName\":\"PostToolUse\",\"additionalContext\":\"RULE 0 - never guess. Every fact about Spencer / a client / a rate / a credit / a date in what you just wrote must be sourced (name the file or page). LOOK IT UP FIRST in the sources Spencer published himself (Voice123, Voices.com, Google Business Profile, LinkedIn, spencerzvoice.com, MEMORY.md, reference/) and fill it in yourself; only when none of them has it, write a [bracket] and say which sources you checked - never a plausible fill-in, and never a bracket for something you could have looked up. If this is a deliverable (email, quote, application, bio, research answer), end it with the verification footer: Verified <fact - source> / Bracketed (you fill) <item> / Unknown <item>.\"}}' || true",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "PY=$(command -v python3 || command -v python); \"$PY\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/ask_spencer_gate.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "PY=$(command -v python3 || command -v python); \"$PY\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/apollo_until_done.py\"",
            "timeout": 90
          }
        ]
      }
    ]
  }
}